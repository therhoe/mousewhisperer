generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Shopify session storage (required by shopify-app-remix)
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Resource type for tracking (product page or collection page)
enum ResourceType {
  PRODUCT
  COLLECTION
}

// A tracking project/audit for a specific product or collection
model Project {
  id              String       @id @default(cuid())
  shop            String       // Shopify shop domain
  resourceType    ResourceType @default(PRODUCT) // Type of page being tracked
  productId       String       // Shopify resource GID (product or collection)
  productTitle    String       // Resource title
  productHandle   String       // URL handle for matching
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  snapshots       Snapshot[]

  @@index([shop])
  @@index([productId])
  @@index([productHandle])
  @@index([resourceType, productHandle])
}

// A snapshot/measurement period within a project
model Snapshot {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  number          Int            // Auto-increment per project: 1, 2, 3...
  name            String?        // User-defined label (e.g., "Baseline", "After Redesign")
  targetVisitors  Int            @default(1000)
  status          SnapshotStatus @default(ACTIVE)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  completedAt     DateTime?

  visits          Visit[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([status])
  @@index([projectId, status])
}

enum SnapshotStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

// Individual visit/session to a product page
model Visit {
  id              String   @id @default(cuid())
  snapshotId      String
  snapshot        Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  // Visitor classification
  visitorType     VisitorType @default(PENDING)

  // Session & page view tracking
  sessionId       String   // Session identifier (persists across page loads)
  pageViewId      String   // Unique per page load (each visit = new pageViewId)

  // Traffic source
  source          String?  // e.g., "google", "facebook", "direct"
  medium          String?  // e.g., "cpc", "organic", "referral"
  campaign        String?  // UTM campaign
  referrer        String?  // Full referrer URL
  sourceCategory  String?  // e.g., "Paid Search", "Organic Social"

  // Engagement metrics
  timeOnPage      Int      @default(0) // milliseconds
  scrollDepth     Int      @default(0) // percentage 0-100
  mouseMovements  Int      @default(0) // count of mouse move events
  keyPresses      Int      @default(0) // count of key press events
  touchEvents     Int      @default(0) // count of touch events (mobile)

  // Geo-location (from IP)
  ipAddress       String?
  country         String?
  countryCode     String?
  city            String?
  region          String?
  timezone        String?

  // Bot detection signals
  hasMouseMoved   Boolean  @default(false)
  hasScrolled     Boolean  @default(false)
  hasKeyPressed   Boolean  @default(false)
  hasTouched      Boolean  @default(false)
  isWebdriver     Boolean  @default(false)
  suspiciousUA    Boolean  @default(false)
  linearMovement  Boolean  @default(false) // bot-like straight-line movement
  datacenterIP    Boolean  @default(false) // IP belongs to known datacenter
  botScore        Int      @default(0)     // 0-100 bot confidence score

  // Conversion events
  addedToCart     Boolean  @default(false)
  addedToCartAt   DateTime?
  converted       Boolean  @default(false)
  convertedAt     DateTime?

  // Timestamps
  startedAt       DateTime @default(now())
  endedAt         DateTime?

  // Exit tracking
  exitType        String?  // window_closed, back_button, idle, internal_link, external_link, checkout
  exitUrl         String?  // URL the visitor navigated to when exiting

  // Search & filter tracking
  searchQuery             String?  // Search term from URL ?q= or referrer
  appliedFilters          String?  // JSON of active filters (filter.v.*, filter.p.*)
  sortBy                  String?  // Sort preference (e.g., "price-ascending")
  filterInteractions      Int      @default(0) // Number of filter changes during visit

  // Device info
  userAgent       String?
  deviceType      String?  // desktop, mobile, tablet

  @@unique([pageViewId, snapshotId])
  @@index([snapshotId])
  @@index([visitorType])
  @@index([sourceCategory])
  @@index([sessionId])
  @@index([country])
  @@index([startedAt])
  // Compound indexes for optimized queries
  @@index([snapshotId, visitorType])  // Filter by snapshot + type
  @@index([snapshotId, startedAt])    // Sort visits by time within snapshot
  @@index([snapshotId, converted])    // Conversion lookups
}

enum VisitorType {
  PENDING   // Not yet classified
  REAL      // Real engaged user (5+ seconds, engagement signals)
  ZOMBIE    // Human but low engagement
  BOT       // Automated traffic
}

// ─── Insights Board ───────────────────────────────────────────

enum InsightCategory {
  HIGH_BOT_TRAFFIC
  LOW_ENGAGEMENT
  SOURCE_QUALITY
  CONVERSION_DROP
  GENERAL
}

model InsightProfile {
  id            String   @id @default(cuid())
  shop          String   @unique
  displayName   String
  storeCategory String?
  avatarEmoji   String?
  reputation    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  insights      Insight[]
  answers       InsightAnswer[]
  votes         InsightVote[]
  meToos        InsightMeToo[]
  bookmarks     InsightBookmark[]
}

model Insight {
  id            String          @id @default(cuid())
  profileId     String
  profile       InsightProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  content       String          // sanitized HTML
  category      InsightCategory
  snapshotStats Json?           // anonymized metrics
  answerCount   Int             @default(0)
  meTooCount    Int             @default(0)
  viewCount     Int             @default(0)
  hasAcceptedAnswer Boolean     @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  answers       InsightAnswer[]
  meToos        InsightMeToo[]
  bookmarks     InsightBookmark[]

  @@index([profileId])
  @@index([category])
  @@index([createdAt])
  @@index([answerCount])
  @@index([meTooCount])
  @@index([category, createdAt])
}

model InsightAnswer {
  id          String         @id @default(cuid())
  insightId   String
  insight     Insight        @relation(fields: [insightId], references: [id], onDelete: Cascade)
  profileId   String
  profile     InsightProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content     String         // sanitized HTML
  upvoteCount Int            @default(0)
  isAccepted  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  votes       InsightVote[]

  @@index([insightId])
  @@index([profileId])
  @@index([insightId, upvoteCount])
}

model InsightVote {
  id        String         @id @default(cuid())
  answerId  String
  answer    InsightAnswer  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  profileId String
  profile   InsightProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([answerId, profileId])
}

model InsightMeToo {
  id        String         @id @default(cuid())
  insightId String
  insight   Insight        @relation(fields: [insightId], references: [id], onDelete: Cascade)
  profileId String
  profile   InsightProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([insightId, profileId])
}

model InsightBookmark {
  id        String         @id @default(cuid())
  insightId String
  insight   Insight        @relation(fields: [insightId], references: [id], onDelete: Cascade)
  profileId String
  profile   InsightProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([insightId, profileId])
}

// Shop-level settings
model ShopSettings {
  id                    String   @id @default(cuid())
  shop                  String   @unique
  setupGuideDismissed   Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
